{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:webview:allow-internal-toggle-devtools",
    "core:menu:allow-new",
    "core:menu:allow-set-as-app-menu",
    "core:resources:allow-close",
    "allow-keyboard-layout-watch",
    "allow-shell-environment-watch",
    "allow-shell-environment-retry",
    "allow-contexts-watch",
    "allow-context-mode-set",
    "allow-context-environment-set",
    "allow-context-unlock",
    "allow-context-relock",
    "allow-command-plan",
    "allow-command-execute",
    "allow-command-cancel",
    "allow-access-review",
    "allow-spaces-list",
    "allow-space-open",
    "allow-state-load",
    "allow-state-set",
    "allow-cluster-version",
    "allow-namespaces-list",
    "allow-context-auth-watch",
    "allow-resources-watch",
    "allow-list-subscribe",
    "allow-list-set-window",
    "allow-list-ack",
    "allow-list-unsubscribe",
    "allow-object-open",
    "allow-object-set-parts",
    "allow-object-ack",
    "allow-object-values",
    "allow-object-close",
    "allow-schema-get",
    "allow-apply-preview",
    "allow-logs-open",
    "allow-logs-set-source",
    "allow-logs-set-view",
    "allow-logs-set-window",
    "allow-logs-ack",
    "allow-logs-download",
    "allow-logs-close",
    "allow-shell-containers",
    "allow-shell-open",
    "allow-shell-input",
    "allow-shell-resize",
    "allow-shell-ack",
    "allow-shell-close",
    "allow-terminal-create",
    "allow-kubeconfig-offers-watch",
    "allow-kubeconfig-offer-answer",
    "allow-context-sign-in",
    "allow-context-sign-in-cancel",
    "allow-exec-review",
    "allow-exec-trust",
    "allow-approvals-watch",
    "allow-approval-answer",
    "allow-url-open"
