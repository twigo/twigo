{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "io.twigo.ide.bench",
  "build": {
    "beforeBuildCommand": "pnpm build:bench",
    "frontendDist": "../dist-bench"
  },
  "app": {
    "windows": [
      {
        "title": "Twigo",
        "width": 1280,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 20
        },
        "x": -1240,
        "y": 100,
        "focus": false
      }
    ]
  }
}
