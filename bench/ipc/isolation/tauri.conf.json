{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twigo IPC bench, isolation",
  "identifier": "io.twigo.bench.ipc",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Twigo IPC bench, isolation",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' twigo-ext:",
      "pattern": {
        "use": "isolation",
        "options": {
          "dir": "../hook"
        }
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../apps/desktop/src-tauri/icons/icon.png"]
  }
}
